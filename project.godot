; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bichobicho"
run/main_scene="uid://ie58kyyqrj2q"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
Bichobicho="*uid://batvaa6sgyvwm"
Dialogic="*uid://ds2q0uclmolvu"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[dialogic]

directories/dch_directory={
"bichero": "res://dialog/Characters/bichero.dch",
"carmen": "res://dialog/Characters/carmen.dch"
}
directories/dtl_directory={
"timeline": "res://dialog/timelines/timeline.dtl"
}
layout/style_directory={}
layout/style_list=[]
layout/default_style="Default"
glossary/default_case_sensitive=true

[editor]

movie_writer/movie_file="/Users/juanjogarridobascaran/Proyectos/ColectivoRayente/Bichobicho/Recording/test.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[global_group]

bichero="El bichero"
bicho=""
door=""

